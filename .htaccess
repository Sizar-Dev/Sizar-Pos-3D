# ==============================================================================
# Sizar POS - Root Directory Protection & Reverse Routing
# ==============================================================================
Options -Indexes -ExecCGI
ServerSignature Off

# Block direct access to dotfiles (.env, .git, .htaccess) and sensitive file extensions
<FilesMatch "(^\.|(\.bak|\.sql|\.gz|\.log|\.ini|\.sh|\.bat|\.md)$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block direct access to internal, sensitive, or developer directories
    RewriteRule ^(\.git|\.agents|Dev_Tools|new_ai|_archive_removed|scratch|security-audit)(/.*)?$ - [F,L]
    RewriteRule ^SizarDev-Pos/(config|src|backups|bundled_maria|scripts|migrations|tests)(/.*)?$ - [F,L]
    RewriteRule \.(md|sql|log)$ - [F,L]

    # Redirect all legitimate requests to SizarDev-Pos/public directory
    RewriteCond %{REQUEST_URI} !^/SizarDev-Pos/public/
    RewriteRule ^(.*)$ SizarDev-Pos/public/$1 [L]
</IfModule>
