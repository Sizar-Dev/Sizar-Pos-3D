# ==============================================================================
# Sizar POS - Core Application Source Code Protection
# ==============================================================================
Options -Indexes -ExecCGI

<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

RemoveHandler .php .phtml .php8 .phar .cgi .pl .py
RemoveType .php .phtml .php8 .phar .cgi .pl .py

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
