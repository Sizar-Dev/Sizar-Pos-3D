# Secure Uploads Directory - Disable script execution
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

RemoveHandler .php .phtml .php3 .php4 .php5 .php6 .php7 .php8 .phps .cgi .pl .asp .aspx .jsp .exe
AddType text/plain .php .phtml .php3 .php4 .php5 .php6 .php7 .php8 .phps .cgi .pl .asp .aspx .jsp .exe

# Block execution under PHP-FPM / FastCGI
<FilesMatch "(?i)\.(php[0-9]?|phtml|phps|cgi|pl|asp|aspx|jsp|exe|sh|bat)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Deny from all
    </IfModule>
</FilesMatch>

Options -ExecCGI -Indexes